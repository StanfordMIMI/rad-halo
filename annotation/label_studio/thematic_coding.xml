<!-- Thematic coding projects (App. E.3); one project per error type.
  Reconstructed from the structure of the Label Studio export of the hallucination project (control
  names, target names and label values); layout and instructions of the original are not recovered.
  The "Error" span is pre-highlighted read-only by scripts/thematic_extract.py. "theme" holds
  "theme name [cluster name]" (exported by scripts/thematic_export.py); "initial_code" and "notes" are
  free text and are not released. -->
<View>
  <View style="display: flex; gap: 20px;">
    <View style="flex: 1;">
      <Header value="REPORT" size="6"/>
      <Labels name="label_findings" toName="text_findings">
        <Label value="Error" background="#ff0000"/>
      </Labels>
      <Text name="text_findings" value="$findings_text"/>
    </View>
    <View style="flex: 1;">
      <Header value="IMPRESSION" size="6"/>
      <Labels name="label_impression" toName="text_impression">
        <Label value="Error" background="#ff0000"/>
      </Labels>
      <Text name="text_impression" value="$impression_text"/>
    </View>
  </View>
  <TextArea name="initial_code" toName="text_findings" rows="2"/>
  <TextArea name="notes" toName="text_findings" rows="3"/>
  <TextArea name="theme" toName="text_findings" rows="1"/>
</View>
